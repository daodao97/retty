{
  "name": "Retty",
  "identifier": "com.daodao.retty",
  "version": "0.1.3",
  "copyright": "Retty — Reconnect TTY / Relay TTY. Inspired by Rex, built with MyGo.",
  "out": "build",
  "icon": "resources/icon.png",
  "updates": {
    "github": "daodao97/retty",
    "publicKey": "+DrpSGHk0b89nfUVaFwnZZv+xvVMbK1UgfhcVIPHinA="
  },
  "macos": {
    "minimumSystemVersion": "13.0",
    "infoPlist": {
      "CFBundleIconName": "RettyAppIcon",
      "NSLocalNetworkUsageDescription": "连接同一 Wi-Fi 下的 Retty 设备，通过局域网加密直连降低终端延迟。"
    }
  },
  "urlSchemes": [
    "retty"
  ],
  "ios": {
    "capabilities": ["camera", "microphone", "speech"],
    "minimumSystemVersion": "15.0",
    "native": {"support": ["browser", "live-activities"]},
    "extensions": [{
      "name": "RettyActivity",
      "extensionPoint": "com.apple.widgetkit-extension",
      "minimumSystemVersion": "16.2",
      "native": {
        "sources": ["resources/ios/RettyLiveActivity.swift"],
        "frameworks": ["SwiftUI", "WidgetKit"],
        "support": ["live-activities"]
      }
    }],
    "infoPlist": {
      "NSSupportsLiveActivities": true,
      "NSCameraUsageDescription": "扫描 Retty 桌面端的二维码以连接终端会话。",
      "NSLocalNetworkUsageDescription": "连接同一 Wi-Fi 下的 Retty 设备，通过局域网加密直连降低终端延迟。",
      "NSMicrophoneUsageDescription": "按住说话，将语音转换为可编辑的终端输入文字。",
      "NSSpeechRecognitionUsageDescription": "使用 Apple 语音识别将说话内容转换为文字。"
    },
    "buildNumber": "1",
    "developmentTeam": "XNDA84PBM3",
    "entitlements": {
      "keychain-access-groups": ["$(AppIdentifierPrefix)*", "com.apple.token"]
    },
    "pushNotifications": true
  }
}
